{
  "name": "azplex",
  "displayName": "azplex",
  "description": "MCP server for Azure, Microsoft Fabric, and Azure DevOps — deploy, manage, and orchestrate from one interface",
  "version": "1.0.0",
  "publisher": "Siddhant",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jhasiddhant/azplex"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "mcp",
    "azure",
    "fabric",
    "devops",
    "bicep",
    "copilot"
  ],
  "icon": "icon.png",
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "mcpServers": {
      "azplex": {
        "command": "${extensionPath}/.venv/bin/python3",
        "args": [
          "-m",
          "azplex.server"
        ],
        "env": {
          "PYTHONPATH": "${extensionPath}/bundled"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run bundle-python",
    "compile": "tsc -p ./",
    "bundle-python": "rm -rf bundled && mkdir -p bundled && cp -r ../src/azplex bundled/",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.96.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.4.0"
  }
}
